---
type AlertColor =
  | "primary"
  | "secondary"
  | "success"
  | "danger"
  | "warning"
  | "info"
  | "light";

interface Props {
  color?: AlertColor;
  title?: string;
}

const { color = "primary", title } = Astro.props;

const colorClasses: Record<AlertColor, string> = {
  primary: "bg-blue-50 border-blue-600 text-blue-900",
  secondary: "bg-gray-100 border-gray-500 text-gray-800",
  success: "bg-green-50 border-green-700 text-green-900",
  danger: "bg-red-50 border-red-600 text-red-900",
  warning: "bg-yellow-50 border-yellow-600 text-yellow-900",
  info: "bg-cyan-50 border-cyan-700 text-cyan-900",
  light: "bg-gray-50 border-gray-400 text-gray-700",
};
---

<!-- Decorative callout box, not a live alert -->
<div class={`border-s-4 px-4 py-2 my-4 ${colorClasses[color]}`} role="note">
  {title && <p class="mt-2 mb-1 font-bold text-lg">{title}</p>}
  <div>
    <slot />
  </div>
</div>
