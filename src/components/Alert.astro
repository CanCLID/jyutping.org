---
type AlertColor =
  | "primary"
  | "secondary"
  | "success"
  | "danger"
  | "warning"
  | "info"
  | "light";

interface Props {
  color?: AlertColor;
  title?: string;
}

const { color = "primary", title } = Astro.props;

const colorClasses: Record<AlertColor, string> = {
  primary: "bg-[#eef5fc] border-[#dbeafa] text-[#0b467e]",
  secondary: "bg-[#f6f9fc] border-[#dce6f0] text-slate-800",
  success: "bg-emerald-50/80 border-emerald-200 text-emerald-950",
  danger: "bg-rose-50/80 border-rose-200 text-rose-950",
  warning: "bg-amber-50/85 border-amber-200 text-amber-950",
  info: "bg-sky-50/85 border-sky-200 text-sky-950",
  light: "bg-[#f6f9fc] border-[#dce6f0] text-slate-700",
};
---

<!-- Decorative callout box, not a live alert -->
<div class={`rounded-2xl border px-5 py-4 my-6 text-base leading-relaxed [&>div>p:first-child]:mt-0 [&>div>p:last-child]:mb-0 ${colorClasses[color]}`} role="note">
  {title && <p class="mt-0 mb-1.5 font-semibold text-base">{title}</p>}
  <div>
    <slot />
  </div>
</div>
