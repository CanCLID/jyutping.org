---
import Icon from "@/components/Icon.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { I18n } from "@/i18n/utils";
import { getNavTranslation } from "@/i18n/pageHeadings";
import { getUiLabels } from "@/i18n/uiLabels";

const { currentLocale, url } = Astro;
const pathname = url.pathname;
const locale = currentLocale || I18n.defaultLocale;
const ui = getUiLabels(locale);
const normalizedPathname = pathname.replace(/\/+$/, "") || "/";
const isHomepage =
  normalizedPathname === "/" ||
  I18n.locales
    .filter((candidate) => candidate !== I18n.defaultLocale)
    .some((candidate) => normalizedPathname === `/${candidate}`);

const navLinkKeys = ["learn", "jyutping", "blog", "keyboard", "about"] as const;
const navLinks = navLinkKeys.map((key) => {
  const baseHref = `/${key}`;
  const href = locale === I18n.defaultLocale ? baseHref : `/${locale}${baseHref}`;
  const isCurrent =
    normalizedPathname === href || normalizedPathname.startsWith(`${href}/`);
  return {
    href,
    isCurrent,
    title: getNavTranslation(key, locale),
  };
});

const logoHref = locale === I18n.defaultLocale ? "/" : `/${locale}`;
---

<header
  id="site-header"
  class:list={[
    "site-header z-50 p-4 text-white",
    isHomepage
      ? "absolute inset-x-0 top-0 bg-transparent"
      : "relative bg-[#1678d3]",
  ]}
>
  <div class="header-inner flex items-center justify-between gap-6 px-4">
    <a
      href={logoHref}
      aria-current={isHomepage ? "page" : undefined}
      class="target-control inline-flex items-center text-white hover:opacity-85 transition-opacity"
    >
      <span class="text-3xl font-jyutping">粵拼</span>
    </a>

    <nav class="site-nav flex items-center" aria-label={ui.primaryNav}>
      <button
        type="button"
        id="menu-button"
        class="menu-button inline-flex items-center justify-center rounded-md text-white hover:bg-white/10 transition-colors cursor-pointer"
        popovertarget="site-menu"
        popovertargetaction="toggle"
        aria-controls="site-menu"
        aria-expanded="false"
        aria-label={ui.openMenu}
      >
        <Icon name="menu-2" size="1.5rem" />
      </button>

      <ul id="site-menu" class="site-menu" popover="auto">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.isCurrent ? "page" : undefined}
              class="text-white text-lg hover:opacity-90 transition-opacity"
            >
              {link.title}
            </a>
          </li>
        ))}
        <li>
          <LanguageSwitcher currentPathname={pathname} locale={locale} />
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const inner = header?.querySelector<HTMLElement>(".header-inner");
  const menuButton = document.getElementById("menu-button");
  const siteMenu = document.getElementById("site-menu");

  if (header && inner && menuButton && siteMenu) {
    let lastWidth = 0;

    const syncLayout = () => {
      const currentWidth = header.getBoundingClientRect().width;
      const wasWide = header.classList.contains("is-wide");

      // Only remeasure when already wide or when the header has grown
      if (!wasWide && currentWidth <= lastWidth) {
        lastWidth = currentWidth;
        return;
      }
      lastWidth = currentWidth;

      const wasOpen = !wasWide && siteMenu.matches(":popover-open, .\\:popover-open");

      header.classList.add("is-measuring");
      header.classList.add("is-wide");
      siteMenu.removeAttribute("popover");

      const fits = inner.scrollWidth <= inner.clientWidth;

      if (!fits) {
        header.classList.remove("is-wide");
        siteMenu.setAttribute("popover", "auto");
        if (wasOpen) {
          siteMenu.showPopover?.();
        }
      }

      menuButton.setAttribute("aria-expanded", String(!fits && wasOpen));

      requestAnimationFrame(() => {
        header.classList.remove("is-measuring");
      });
    };

    siteMenu.addEventListener("toggle", (event) => {
      const toggleEvent = event as ToggleEvent;
      if (!header.classList.contains("is-wide")) {
        menuButton.setAttribute("aria-expanded", String(toggleEvent.newState === "open"));
      }
    });

    siteMenu.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (!header.classList.contains("is-wide") && target.closest("a[href]")) {
        siteMenu.hidePopover?.();
      }
    });

    syncLayout();

    const resizeObserver = new ResizeObserver(syncLayout);
    resizeObserver.observe(header);
    resizeObserver.observe(siteMenu);
  }
</script>
