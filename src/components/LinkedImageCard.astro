---
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  heading: string;
  headingLevel?: "h2" | "h3";
  href: string;
  alt: string;
  image?: ImageMetadata;
  publicSrc?: string;
  publicWidth?: number;
  publicHeight?: number;
  containerClassName?: string;
  headingClassName?: string;
  linkClassName?: string;
  imageClassName?: string;
}

const {
  heading,
  headingLevel = "h3",
  href,
  alt,
  image,
  publicSrc,
  publicWidth,
  publicHeight,
  containerClassName = "flex flex-col items-center p-4",
  headingClassName = "my-4 text-2xl font-semibold",
  linkClassName = "block w-full max-w-md transition-opacity duration-200 hover:opacity-80",
  imageClassName = "mx-auto h-auto max-w-full rounded-lg shadow-sm hover:shadow-md",
} = Astro.props;

const HeadingTag = headingLevel;
---

<div class={containerClassName}>
  <HeadingTag class={headingClassName}>{heading}</HeadingTag>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    class={linkClassName}
  >
    {image ? (
      image.format === "svg" ? (
        <Image
          src={image}
          alt={alt}
          format="svg"
          width={image.width}
          height={image.height}
          class={imageClassName}
          loading="lazy"
        />
      ) : (
        <Picture
          src={image}
          alt={alt}
          formats={["avif", "webp"]}
          widths={[320, 640, 960]}
          sizes="(max-width: 768px) 100vw, 28rem"
          class={imageClassName}
          loading="lazy"
        />
      )
    ) : (
      <img
        src={publicSrc}
        alt={alt}
        width={publicWidth}
        height={publicHeight}
        class={imageClassName}
        loading="lazy"
      />
    )}
  </a>
</div>
