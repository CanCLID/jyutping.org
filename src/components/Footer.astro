---
import Icon from "@/components/Icon.astro";
import { I18n, type Locale } from "@/i18n/utils";
import { getNavTranslation } from "@/i18n/pageHeadings";
import { getUiLabels } from "@/i18n/uiLabels";
import { getRssPath } from "@/utils/content";

const { currentLocale } = Astro;
const locale = currentLocale || I18n.defaultLocale;
const resolvedLocale = I18n.locales.includes(locale as Locale)
  ? (locale as Locale)
  : I18n.defaultLocale;
const ui = getUiLabels(locale);
const currentYear = new Date().getFullYear();

const logoHref = resolvedLocale === I18n.defaultLocale ? "/" : `/${resolvedLocale}`;
const navLinkKeys = ["learn", "jyutping", "blog", "keyboard", "about"] as const;
const footerNavLinks = navLinkKeys.map((key) => ({
  href: resolvedLocale === I18n.defaultLocale ? `/${key}` : `/${resolvedLocale}/${key}`,
  title: getNavTranslation(key, locale),
}));
const rssHref = getRssPath(resolvedLocale);
---

<footer class="bg-[#0f2942] text-white">
  <div class="mx-auto max-w-7xl px-6 py-9">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <a
        href={logoHref}
        class="target-control inline-flex items-baseline gap-2.5 text-white no-underline hover:opacity-85 transition-opacity"
      >
        <span class="font-jyutping text-4xl leading-[1.25] text-white">粵拼</span>
        <span class="text-sm font-medium text-white/75">jyutping.org</span>
      </a>

      <nav aria-label={ui.primaryNav}>
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2">
          {
            footerNavLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="target-control inline-flex items-center text-[0.9375rem] font-medium text-white/80 hover:text-white transition-colors"
                >
                  {link.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="inline-flex items-center gap-1.5">
        <a
          href="https://github.com/CanCLID/jyutping.org"
          target="_blank"
          rel="noopener noreferrer"
          class="target-control inline-flex items-center justify-center rounded-full p-2 text-white/85 hover:bg-white/10 hover:text-white transition-colors"
          aria-label={ui.githubLabel}
        >
          <Icon name="brand-github" size="1.25rem" />
        </a>
        <a
          href="mailto:support@jyutping.org"
          target="_blank"
          rel="noopener noreferrer"
          class="target-control inline-flex items-center justify-center rounded-full p-2 text-white/85 hover:bg-white/10 hover:text-white transition-colors"
          aria-label={ui.emailLabel}
        >
          <Icon name="mail" size="1.25rem" />
        </a>
        <a
          href="https://huggingface.co/CanCLID"
          target="_blank"
          rel="noopener noreferrer"
          class="target-control inline-flex items-center justify-center rounded-full p-2 text-white/85 hover:bg-white/10 hover:text-white transition-colors"
          aria-label={ui.huggingFaceLabel}
        >
          <Icon name="huggingface" size="1.25rem" />
        </a>
        <a
          href="https://x.com/Can_CLID"
          target="_blank"
          rel="noopener noreferrer"
          class="target-control inline-flex items-center justify-center rounded-full p-2 text-white/85 hover:bg-white/10 hover:text-white transition-colors"
          aria-label={ui.xLabel}
        >
          <Icon name="brand-x" size="1.25rem" />
        </a>
      </div>
    </div>

    <div class="mt-6 flex flex-col items-start justify-between gap-3 border-t border-white/10 pt-5 text-xs sm:text-sm text-white/70 sm:flex-row sm:items-center">
      <span>&copy; {currentYear} jyutping.org</span>
      <a
        href={rssHref}
        class="target-control inline-flex items-center font-medium text-white/75 hover:text-white transition-colors"
      >
        RSS
      </a>
    </div>
  </div>
</footer>
