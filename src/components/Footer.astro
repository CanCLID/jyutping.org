---
import Icon from "@/components/Icon.astro";
import { I18n } from "@/i18n/utils";
import { getUiLabels } from "@/i18n/uiLabels";

const { currentLocale } = Astro;
const locale = currentLocale || I18n.defaultLocale;
const ui = getUiLabels(locale);
const currentYear = new Date().getFullYear();
---

<footer class="p-8 bg-gray-700 text-center text-white">
  <div class="my-2">
    <span>&copy; {currentYear} jyutping.org</span>
  </div>

  <div class="my-2 inline-flex items-center justify-center gap-2">
    <a
      href="https://github.com/CanCLID/jyutping.org"
      target="_blank"
      rel="noopener noreferrer"
      class="target-control inline-flex items-center justify-center p-2 text-white hover:opacity-80 transition-opacity"
      aria-label={ui.githubLabel}
    >
      <Icon name="brand-github" size="1.25rem" />
    </a>
    <a
      href="mailto:support@jyutping.org"
      target="_blank"
      rel="noopener noreferrer"
      class="target-control inline-flex items-center justify-center p-2 text-white hover:opacity-80 transition-opacity"
      aria-label={ui.emailLabel}
    >
      <Icon name="mail" size="1.25rem" />
    </a>
    <a
      href="https://huggingface.co/CanCLID"
      target="_blank"
      rel="noopener noreferrer"
      class="target-control inline-flex items-center justify-center p-2 text-white hover:opacity-80 transition-opacity"
      aria-label={ui.huggingFaceLabel}
    >
      <Icon name="huggingface" size="1.25rem" />
    </a>
    <a
      href="https://x.com/Can_CLID"
      target="_blank"
      rel="noopener noreferrer"
      class="target-control inline-flex items-center justify-center p-2 text-white hover:opacity-80 transition-opacity"
      aria-label={ui.xLabel}
    >
      <Icon name="brand-x" size="1.25rem" />
    </a>
  </div>
</footer>
