---
import Audio from "@/components/Audio.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { I18n } from "@/i18n/utils";
import { getUiLabels } from "@/i18n/uiLabels";

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale || I18n.defaultLocale } = Astro.props;
const ui = getUiLabels(locale);
const tones = [1, 2, 3, 4, 5, 6] as const;
---

<ScrollableTable
  caption={ui.tonePracticeTableCaption}
  captionId="tone-practice-table-caption"
  sticky
>
  <thead>
    <tr>
      <th class="text-center" scope="col">
        <span class="inline-block -scale-y-100" aria-hidden="true">⤷</span>
      </th>
      {tones.map((colTone) => (
        <th class="text-center" scope="col">{colTone}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    {tones.map((rowTone) => (
      <tr>
        <th class="sticky-row-header text-center font-semibold" scope="row">{rowTone}</th>
        {tones.map((colTone) => (
          <td class={rowTone === colTone ? "bg-[#eef5fc]/50 text-center" : "text-center"}>
            <span class="inline-flex items-center gap-0.5 whitespace-nowrap font-mono text-base font-medium text-slate-700">
              <span>{`${rowTone}￫${colTone}`}</span>
              <Audio id={`${rowTone}${colTone}`} locale={locale} />
            </span>
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</ScrollableTable>
