---
import PageBanner from "@/components/PageBanner.astro";

interface Props {
  description?: string;
  eyebrow?: string;
  title: string;
}

const { description, eyebrow, title } = Astro.props;
---

<PageBanner eyebrow={eyebrow} title={title} subtitle={description} maxWidth="wide" />

<div class="mx-auto flex max-w-[88rem] justify-center gap-7 px-5 sm:px-6 py-8 md:py-10">
  <aside class="hidden w-48 shrink-0 lg:block">
    <div class="sticky top-24">
      <slot name="catalogue" />
    </div>
  </aside>

  <article class="prose min-w-0 grow">
    <slot />
  </article>

  <aside class="hidden w-48 shrink-0 lg:block">
    <div class="sticky top-24">
      <slot name="toc" />
    </div>
  </aside>
</div>
