---
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/components/icons/iconPaths";

interface Props {
  kind: "github" | "keyboard" | "mail";
}

const { kind } = Astro.props;

const iconByKind: Record<Props["kind"], IconName> = {
  github: "brand-github",
  keyboard: "keyboard",
  mail: "mail",
};
---

<li class="flex items-start">
  <Icon name={iconByKind[kind]} size="1.25rem" class="mt-1 me-3 text-gray-500" />
  <div class="min-w-0">
    <slot />
  </div>
</li>
