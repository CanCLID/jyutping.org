---
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/components/icons/iconPaths";

interface Props {
  kind: "github" | "keyboard" | "mail";
}

const { kind } = Astro.props;

const iconByKind: Record<Props["kind"], IconName> = {
  github: "brand-github",
  keyboard: "keyboard",
  mail: "mail",
};
---

<li class="flex items-start gap-3.5">
  <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-xl bg-[#eef5fc] text-[#1678d3]">
    <Icon name={iconByKind[kind]} size="1.25rem" />
  </span>
  <div class="min-w-0 pt-1">
    <slot />
  </div>
</li>
