---
interface Props {
  href: string;
  className?: string;
  label?: string;
  newTab?: boolean;
  rel?: string;
}

const {
  href,
  className,
  label,
  newTab = /^https?:\/\//.test(Astro.props.href),
  rel: relOverride,
} = Astro.props;

const rel = newTab ? relOverride ?? "noopener noreferrer" : relOverride;
---

<a
  href={href}
  target={newTab ? "_blank" : undefined}
  rel={rel}
  class:list={[
    "text-[#0e5394] hover:text-[#0b467e] underline decoration-[#dbeafa] hover:decoration-current underline-offset-[0.2em] transition-colors",
    className,
  ]}
>{label ?? <slot />}</a>
