---
import { render } from "astro:content";
import TableOfContents from "@/components/TableOfContents.astro";
import CodaTable from "@/components/jyutping/CodaTable.astro";
import FinalsChart from "@/components/jyutping/FinalsChart.astro";
import NucleiTable from "@/components/jyutping/NucleiTable.astro";
import OnsetTable from "@/components/jyutping/OnsetTable.astro";
import ReferenceList from "@/components/jyutping/ReferenceList.astro";
import SectionHeading from "@/components/jyutping/SectionHeading.astro";
import SubsectionHeading from "@/components/jyutping/SubsectionHeading.astro";
import SyllabicNasalTable from "@/components/jyutping/SyllabicNasalTable.astro";
import ToneTable from "@/components/jyutping/ToneTable.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getJyutpingSections } from "@/data/jyutping";
import type { Locale } from "@/i18n/utils";
import { makeTitle } from "@/i18n/pageHeadings";
import { getPageMeta } from "@/i18n/pageMeta";
import { getLocalizedSingletonEntry, toCanonicalUrl } from "@/utils/content";
import { buildJyutpingSchemeJsonLd, getCanonicalSiteUrl } from "@/utils/jsonLd";
import { sharedMdxComponents } from "@/utils/mdx";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const entry = await getLocalizedSingletonEntry("jyutping", locale);
const { Content } = await render(entry);
const headings = getJyutpingSections(locale);
const description = entry.data.description ?? getPageMeta(locale).descriptions.jyutping;
const siteUrl = getCanonicalSiteUrl(Astro.site);
const jsonLd = buildJyutpingSchemeJsonLd({
  siteUrl,
  locale,
  title: makeTitle(entry.data.title, locale),
  description,
  canonicalUrl: toCanonicalUrl(Astro.url.pathname, siteUrl),
});
---

<BaseLayout
  lang={locale}
  title={entry.data.title}
  description={description}
  jsonLd={jsonLd}
>
  <div class="bg-[#1678d3] text-white px-4 py-6 mb-8">
    <h1
      class="font-jyutping my-4 text-5xl md:text-6xl leading-relaxed text-center container max-w-8xl mx-auto"
    >
      粵拼<span class="text-[70%]">：</span>香港語言學學會粵語拼音方案
    </h1>
    <p
      lang="en"
      class="my-8 text-3xl md:text-4xl text-center container max-w-8xl mx-auto text-balance"
    >
      Jyutping: The Linguistic Society of Hong Kong <br /> Cantonese Romanization
      Scheme
    </p>
  </div>
  <div class="flex justify-center gap-8 max-w-5xl mx-auto">
    <article class="container max-w-4xl min-w-0 mx-auto p-4">
      <Content
        components={{
          ...sharedMdxComponents,
          CodaTable,
          FinalsChart,
          NucleiTable,
          OnsetTable,
          ReferenceList,
          SectionHeading,
          SubsectionHeading,
          SyllabicNasalTable,
          ToneTable,
        }}
      />
    </article>
    <aside class="hidden lg:block w-32 shrink-0">
      <div class="sticky top-32">
        <TableOfContents headings={headings} locale={locale} />
      </div>
    </aside>
  </div>
</BaseLayout>
