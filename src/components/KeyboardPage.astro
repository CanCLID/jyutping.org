---
import { Picture } from "astro:assets";
import DownloadButton from "@/components/DownloadButton.astro";
import Icon from "@/components/Icon.astro";
import LinkedImageCard from "@/components/LinkedImageCard.astro";
import PageBanner from "@/components/PageBanner.astro";
import YouTubeFacade from "@/components/YouTubeFacade.astro";
import { getTitle } from "@/i18n/pageHeadings";
import { getPageMeta } from "@/i18n/pageMeta";
import { getTranslations } from "@/i18n/pages/keyboard";
import { getUiLabels } from "@/i18n/uiLabels";
import { I18n, type Locale } from "@/i18n/utils";
import converterImage from "@/assets/images/keyboard/converter.png";
import flippedImage from "@/assets/images/keyboard/flipped.png";
import googleTranslateImage from "@/assets/images/keyboard/google-translate-hero.png";
import hambaanglaangImage from "@/assets/images/keyboard/hambaanglaang.png";
import injectImage from "@/assets/images/keyboard/inject.png";
import jyutjyuImage from "@/assets/images/keyboard/jyutjyu-og.png";
import jyutNetImage from "@/assets/images/keyboard/jyut-net-hero.jpg";
import learnduckImage from "@/assets/images/keyboard/learnduck.png";
import otterboardImage from "@/assets/images/keyboard/otterboard.png";
import wingImage from "@/assets/images/keyboard/wing.png";
import wordsHkImage from "@/assets/images/keyboard/wordshk.png";
import youtubePoster from "@/assets/images/keyboard/youtube-52min.jpg";

interface Props {
  locale: string;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const resolvedLocale = I18n.locales.includes(locale as Locale)
  ? (locale as Locale)
  : I18n.defaultLocale;
const t = getTranslations(locale);
const ui = getUiLabels(locale);
const resolvedTitle = title ?? getTitle("keyboard", locale);
const resolvedDescription = description ?? getPageMeta(resolvedLocale).descriptions.keyboard;

const sectionJumpLinks = [
  { href: "#input-methods", icon: "keyboard" as const, label: t.introLinks },
  { href: "#dictionaries", icon: "book-2" as const, label: t.toolsTitle },
  { href: "#learning", icon: "books" as const, label: t.resourceTitle },
];
---

<PageBanner title={resolvedTitle} subtitle={resolvedDescription}>
  <div class="mt-6 flex flex-wrap gap-2.5">
    {
      sectionJumpLinks.map((item) => (
        <a
          href={item.href}
          class="target-control inline-flex items-center gap-2 rounded-full border border-white/30 bg-[#0b467e]/30 px-4 py-1.5 text-sm font-medium text-white transition-colors hover:border-white/55 hover:bg-[#0b467e]/45"
        >
          <Icon name={item.icon} size="1rem" />
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</PageBanner>

<section id="input-methods" class="bg-white py-10 md:py-14">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-8 flex items-center gap-3 border-b border-[#dce6f0] pb-4">
      <Icon name="keyboard" size="1.75rem" class="shrink-0 text-[#1678d3]" />
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        {t.introLinks}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <div class="surface-card ring-1 ring-[#dce6f0]/80 flex flex-col p-6">
        <h3 class="mb-4 text-xl font-semibold text-slate-900">{t.sogouTitle}</h3>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">iOS</p>
        <div class="mb-4">
          <DownloadButton
            href="https://apps.apple.com/app/id917670924"
            icon="brand-apple"
            text={t.sogouAppStoreButton}
            variant="apple"
          />
          <p class="mt-1.5 text-sm text-slate-600">{t.sogouAppStoreNote}</p>
        </div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Android</p>
        <div class="mb-4">
          <DownloadButton
            href="https://shouji.sogou.com/interface/multilingual.php?language=3"
            icon="brand-android"
            text={t.sogouApkButton}
            variant="android"
          />
          <p class="mt-1.5 text-sm text-slate-600">{t.sogouApkNote}</p>
        </div>
        <p class="mt-auto text-[0.9375rem] leading-relaxed text-slate-700">{t.sogouInstructions}</p>
      </div>

      <div class="surface-card ring-1 ring-[#dce6f0]/80 flex flex-col p-6">
        <h3 class="mb-4 text-xl font-semibold text-slate-900">{t.typeduckTitle}</h3>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Web</p>
        <div class="mb-4">
          <DownloadButton
            href="https://www.typeduck.hk/web/"
            icon="world"
            text={t.typeduckWeb}
            variant="web"
          />
        </div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
          Windows, macOS, iOS, Android
        </p>
        <div>
          <DownloadButton
            href="https://www.typeduck.hk/"
            icon="download"
            text={t.typeduckDownload}
            variant="typeduck"
          />
        </div>
      </div>

      <div class="surface-card ring-1 ring-[#dce6f0]/80 flex flex-col p-6">
        <h3 class="mb-4 text-xl font-semibold text-slate-900">{t.appJyutpingTitle}</h3>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">iOS</p>
        <div class="mb-4">
          <DownloadButton
            href="https://apps.apple.com/app/id1509367629"
            icon="brand-apple"
            text={t.appJyutpingAppStoreButton}
            variant="apple"
          />
        </div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Android</p>
        <div class="mb-4">
          <DownloadButton
            href="https://play.google.com/store/apps/details?id=org.jyutping.jyutping&hl=zh-HK&gl=HK"
            icon="brand-google-play"
            text={t.appJyutpingGooglePlayButton}
            variant="googleplay"
          />
        </div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
          Windows, macOS, Android
        </p>
        <div>
          <DownloadButton
            href="https://jyutping.app"
            icon="download"
            text={t.appJyutpingWebsiteDownload}
            variant="web"
          />
        </div>
      </div>

      <div class="surface-card ring-1 ring-[#dce6f0]/80 flex flex-col p-6">
        <h3 class="mb-4 text-xl font-semibold text-slate-900">rime-cantonese</h3>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">
          Windows, macOS, Linux, iOS, Android
        </p>
        <div>
          <DownloadButton
            href="https://jyutping.net/"
            icon="download"
            text="jyutping.net"
            variant="web"
          />
        </div>
      </div>

      <div class="surface-card ring-1 ring-[#dce6f0]/80 flex flex-col p-6">
        <h3 class="mb-4 text-xl font-semibold text-slate-900">{t.gboardTitle}</h3>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">iOS</p>
        <div class="mb-4">
          <DownloadButton
            href="https://apps.apple.com/app/id1091700242"
            icon="brand-apple"
            text={t.gboardAppStoreButton}
            variant="apple"
          />
        </div>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">Android</p>
        <div>
          <DownloadButton
            href="https://play.google.com/store/apps/details?id=com.google.android.inputmethod.latin&hl=en_US"
            icon="brand-google-play"
            text={t.gboardGooglePlayButton}
            variant="googleplay"
          />
        </div>
      </div>

      <div class="surface-card ring-1 ring-[#dce6f0]/80 flex flex-col p-6">
        <h3 class="mb-4 text-xl font-semibold text-slate-900">{t.cantoboardTitle}</h3>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">iOS</p>
        <div>
          <DownloadButton
            href="https://apps.apple.com/app/id6752963850"
            icon="brand-apple"
            text={t.cantoboardAppStoreButton}
            variant="apple"
          />
        </div>
      </div>

      <div class="surface-card ring-1 ring-[#dce6f0]/80 flex flex-col p-6">
        <h3 class="mb-4 text-xl font-semibold text-slate-900">{t.otterboardTitle}</h3>
        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-500">iOS</p>
        <div class="mt-2 flex items-center gap-4">
          <a
            href="https://apps.apple.com/app/id6803947273"
            target="_blank"
            rel="noopener noreferrer"
            class="target-control inline-block shrink-0 transition-opacity duration-200 hover:opacity-80"
          >
            <Picture
              src={otterboardImage}
              alt={t.otterboardTitle}
              formats={["avif", "webp"]}
              widths={[128, 256]}
              sizes="3.5rem"
              class="size-14 rounded-xl ring-1 ring-slate-900/6"
              loading="lazy"
            />
          </a>
          <DownloadButton
            href="https://apps.apple.com/app/id6803947273"
            icon="brand-apple"
            text={t.cantoboardAppStoreButton}
            variant="apple"
          />
        </div>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
      <LinkedImageCard
        heading="LearnDuck 粵拼打字入門"
        headingLevel="h3"
        href="https://chaaklau.github.io/LearnDuck/"
        alt="LearnDuck 粵拼打字入門"
        image={learnduckImage}
        mediaFit="contain"
      />
      <LinkedImageCard
        heading="粵拼打字練習工具"
        headingLevel="h3"
        href="https://jyutping.io/"
        alt="粵拼打字練習工具"
        publicSrc="/img/jyutping-io-logo-with-bar.svg"
        publicWidth={599}
        publicHeight={247}
        mediaFit="contain"
      />
    </div>
  </div>
</section>

<section id="dictionaries" class="defer-section bg-[#f6f9fc] py-10 md:py-14">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-8 flex items-center gap-3 border-b border-[#dce6f0] pb-4">
      <Icon name="book-2" size="1.75rem" class="shrink-0 text-[#1678d3]" />
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        {t.toolsTitle}
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <LinkedImageCard
        heading="粵音資料集叢 jyut.net"
        href="https://jyut.net/"
        alt="粵音資料集叢"
        image={jyutNetImage}
      />
      <LinkedImageCard
        heading="粵語辭叢"
        href="https://jyutjyu.com/"
        alt="粵語辭叢 jyutjyu.com"
        image={jyutjyuImage}
      />
      <LinkedImageCard
        heading="粵典 words.hk"
        href="https://words.hk/"
        alt="粵典"
        image={wordsHkImage}
      />
      <LinkedImageCard
        heading="羊羊粵語 shyyp.net"
        href="https://shyyp.net/hant"
        alt="羊羊粵語"
        publicSrc="/img/shyyp.svg"
        publicWidth={256}
        publicHeight={256}
        mediaFit="contain"
      />
      <LinkedImageCard
        heading={t.googleTranslate}
        href="https://translate.google.com/?hl=yue&sl=auto&tl=en&op=translate"
        alt="Google Translate Cantonese"
        image={googleTranslateImage}
      />
      <LinkedImageCard
        heading={t.converter}
        href="https://jyutping.net/converter/"
        alt="Jyutping Converter"
        image={converterImage}
      />
    </div>

    <div class="mt-6 surface-card ring-1 ring-[#dce6f0]/80 flex flex-col items-center justify-between gap-6 p-6 sm:flex-row sm:p-8">
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/CanCLID/inject-jyutping"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 transition-opacity duration-200 hover:opacity-80"
        >
          <Picture
            src={injectImage}
            alt="Inject Jyutping Logo"
            formats={["avif", "webp"]}
            widths={[64, 128]}
            sizes="4rem"
            class="size-16 rounded-xl"
            loading="lazy"
          />
        </a>
        <div>
          <h3 class="text-xl font-semibold text-slate-900">
            注入粵拼 inject-jyutping
          </h3>
          <p class="mt-0.5 text-sm text-slate-500">github.com/CanCLID/inject-jyutping</p>
        </div>
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        <DownloadButton
          href="https://chromewebstore.google.com/detail/inject-jyutping/lfgpgjkjglogbndlkikjgbbfoiofbdjp"
          icon="brand-chrome"
          text="Chrome Web Store"
          variant="chrome"
        />
        <DownloadButton
          href="https://addons.mozilla.org/en-US/firefox/addon/inject-jyutping/"
          icon="brand-firefox"
          text="Firefox Add-ons"
          variant="firefox"
        />
      </div>
    </div>
  </div>
</section>

<section id="learning" class="defer-section bg-white py-10 md:py-14">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-8 flex items-center gap-3 border-b border-[#dce6f0] pb-4">
      <Icon name="books" size="1.75rem" class="shrink-0 text-[#1678d3]" />
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
        {t.resourceTitle}
      </h2>
    </div>

    <h3 class="mb-5 text-center text-xl font-semibold text-slate-800">52 分鐘學識粵拼</h3>
    <YouTubeFacade
      videoId="MOsf0BcLzlc"
      title="YouTube video player: 52 分鐘學識粵拼"
      playLabel={ui.playVideo}
      poster={youtubePoster}
    />

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      <LinkedImageCard
        heading="冚唪唥粵文 hambaanglaang.hk"
        href="https://hambaanglaang.hk/"
        alt="冚唪唥粵文 Hambaanglaang"
        image={hambaanglaangImage}
      />
      <LinkedImageCard
        heading="香港理工大学 翻轉粵語教室"
        href="https://www.polyu.edu.hk/clc/cantonese/home/"
        alt="翻轉粵語教室 Flipped Classroom"
        image={flippedImage}
      />
      <LinkedImageCard
        heading="粵拼字體 visual-fonts.com"
        href="https://visual-fonts.com/"
        alt="Visual Fonts Jyutping"
        publicSrc="/img/visualfont.svg"
        publicWidth={254}
        publicHeight={50}
        mediaFit="contain"
      />
      <LinkedImageCard
        heading="Wing Font"
        href="https://wing-fonts.chunlaw.io/"
        alt="Wing Font"
        image={wingImage}
        mediaFit="contain"
      />
    </div>
  </div>
</section>
