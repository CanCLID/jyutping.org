---
import { I18n } from "@/i18n/utils";
import type { CollectionEntry } from "astro:content";
import { getTitle } from "@/i18n/pageHeadings";
import { getUiLabels } from "@/i18n/uiLabels";
import { getEntrySlug } from "@/utils/content";

const { currentLocale } = Astro;
const locale = currentLocale || I18n.defaultLocale;

const title = getTitle("blog", locale);
const ui = getUiLabels(locale);

interface Props {
  posts: CollectionEntry<"blog">[];
  currentSlug: string;
}

const { posts, currentSlug } = Astro.props;
---

<nav aria-label={ui.blogCatalogue}>
  <h2 class="text-2xl px-4 font-bold mb-4">{title}</h2>
  <ul class="space-y-2 px-4">
    {
      posts.map((post) => {
        const postSlug = getEntrySlug(post.id);
        const localePrefix = locale === I18n.defaultLocale ? "" : `/${locale}`;
        const postLink = `${localePrefix}/blog/${postSlug}/`;
        const isActive = postSlug === currentSlug;
        return (
          <li>
            <a
              href={postLink}
              class:list={[
                "target-control inline-flex items-center text-lg hover:text-blue-700",
                { "font-bold underline underline-offset-4": isActive },
              ]}
              aria-current={isActive ? "page" : undefined}
            >
              {post.data.title}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
