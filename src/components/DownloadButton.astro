---
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/components/icons/iconPaths";

interface Props {
  href: string;
  icon: IconName;
  text: string;
  variant?:
    | "googleplay"
    | "android"
    | "apple"
    | "web"
    | "typeduck"
    | "firefox"
    | "chrome";
}

const {
  href,
  icon,
  text,
  variant = "web",
} = Astro.props;

const baseClasses =
  "target-control group inline-flex items-center rounded-xl px-4 py-2.5 text-sm sm:text-[0.9375rem] font-semibold ring-1 ring-inset transition-colors duration-150 ease-in-out";

const variantClassesByKind: Record<NonNullable<Props["variant"]>, string> = {
  googleplay:
    "bg-emerald-50 text-[#017552] ring-emerald-700/15 hover:bg-[#017552] hover:text-white hover:ring-[#017552]",
  android:
    "bg-green-50 text-[#197332] ring-green-700/15 hover:bg-[#197332] hover:text-white hover:ring-[#197332]",
  apple:
    "bg-slate-100 text-slate-900 ring-slate-900/10 hover:bg-slate-900 hover:text-white hover:ring-slate-900",
  typeduck:
    "bg-amber-50 text-amber-800 ring-amber-700/15 hover:bg-amber-700 hover:text-white hover:ring-amber-700",
  chrome:
    "bg-[#eef5fc] text-[#0e5394] ring-[#1678d3]/15 hover:bg-[#1678d3] hover:text-white hover:ring-[#1678d3]",
  firefox:
    "download-btn-firefox bg-purple-50 text-purple-800 ring-purple-700/15 hover:bg-gradient-to-r hover:from-purple-700 hover:via-pink-700 hover:to-orange-700 hover:text-white hover:ring-transparent",
  web:
    "bg-[#eef5fc] text-[#0b467e] ring-[#1678d3]/15 hover:bg-[#1678d3] hover:text-white hover:ring-[#1678d3]",
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[baseClasses, variantClassesByKind[variant]]}
>
  <Icon name={icon} size="1.25rem" class="me-2" />
  {text}
</a>
