---
import Icon from "@/components/Icon.astro";
import type { IconName } from "@/components/icons/iconPaths";

interface Props {
  href: string;
  icon: IconName;
  text: string;
  variant?:
    | "googleplay"
    | "android"
    | "apple"
    | "web"
    | "typeduck"
    | "firefox"
    | "chrome";
}

const {
  href,
  icon,
  text,
  variant = "web",
} = Astro.props;

const baseClasses =
  "target-control group inline-flex items-center rounded-md border px-6 py-3 text-base font-medium transition-colors duration-150 ease-in-out";

const variantClassesByKind: Record<NonNullable<Props["variant"]>, string> = {
  googleplay:
    "border-[#017552] bg-transparent text-[#017552] hover:bg-[#017552] hover:text-white",
  android:
    "border-[#197332] bg-transparent text-[#197332] hover:bg-[#197332] hover:text-white",
  apple:
    "border-black bg-transparent text-black hover:bg-black hover:text-white",
  typeduck:
    "border-amber-700 bg-transparent text-amber-700 hover:bg-amber-700 hover:text-white",
  chrome:
    "border-[#1967d2] bg-transparent text-[#1967d2] hover:bg-[#1967d2] hover:text-white",
  firefox:
    "download-btn-firefox border-purple-700 bg-transparent text-purple-700 hover:border-transparent hover:bg-gradient-to-r hover:from-purple-700 hover:via-pink-700 hover:to-orange-700 hover:text-white",
  web:
    "border-blue-700 bg-transparent text-blue-700 hover:bg-blue-700 hover:text-white",
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[baseClasses, variantClassesByKind[variant]]}
>
  <Icon name={icon} size="1.25rem" class="me-2" />
  {text}
</a>
