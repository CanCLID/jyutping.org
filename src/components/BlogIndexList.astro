---
import Icon from "@/components/Icon.astro";
import PageBanner from "@/components/PageBanner.astro";

interface BlogPost {
  title: string;
  slug: string;
  description?: string;
}

interface BlogTranslations {
  title: string;
  readMore: string;
  noPosts: string;
}

interface Props {
  description?: string;
  posts: BlogPost[];
  translations: BlogTranslations;
}

const { description, posts, translations } = Astro.props;
---

<PageBanner title={translations.title} subtitle={description} maxWidth="7xl" />

<div class="mx-auto max-w-7xl px-6 py-10 md:py-12">
  {
    posts.length > 0 ? (
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {posts.map((post) => (
          <article class="surface-card surface-card-interactive ring-1 ring-[#dce6f0]/80">
            <a
              href={post.slug}
              class="group flex h-full flex-col justify-between p-7 no-underline"
            >
              <div>
                <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-slate-900 transition-colors group-hover:text-[#0b467e]">
                  {post.title}
                </h2>
                {post.description && (
                  <p class="mt-2.5 text-base sm:text-[1.0625rem] leading-relaxed text-slate-600">
                    {post.description}
                  </p>
                )}
              </div>
              <span class="mt-6 inline-flex items-center gap-1.5 text-base font-semibold text-[#1678d3] transition-colors group-hover:text-[#0b467e]">
                {translations.readMore}
                <Icon
                  name="arrow-right"
                  size="1.125rem"
                  class="transition-transform group-hover:translate-x-0.5"
                />
              </span>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <p class="text-slate-600">{translations.noPosts}</p>
    )
  }
</div>
