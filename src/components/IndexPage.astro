---
import { Image, Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Audio from "@/components/Audio.astro";
import Icon from "@/components/Icon.astro";
import JyutpingTypingDemo from "@/components/JyutpingTypingDemo.astro";
import type { IconName } from "@/components/icons/iconPaths";
import type { Locale } from "@/i18n/utils";
import { I18n, formatBcp47Locale } from "@/i18n/utils";
import { getTranslations } from "@/i18n/pages/index";
import cantoboardLogo from "@/assets/images/home/cantoboard.png";
import flippedLogo from "@/assets/images/home/flipped.png";
import googleTranslateLogo from "@/assets/images/home/google-translate.png";
import hambaanglaangLogo from "@/assets/images/home/hambaanglaang-logo-neon.png";
import jyutnetLogo from "@/assets/images/home/jyutnet-icon.webp";
import jyutpingAppLogo from "@/assets/images/home/jyutping-app.svg";
import learnduckLogo from "@/assets/images/home/learnduck.png";
import typeduckLogo from "@/assets/images/home/typeduck-app-icon.jpg";

interface Props {
  locale: string;
}

type ToolCardTool = {
  backgroundClassName?: string;
  href: string;
  name: string;
  sub: string;
} & (
  | {
      image: ImageMetadata;
      publicSrc?: never;
    }
  | {
      image?: never;
      publicSrc: string;
    }
);

type ToolCard = {
  accentClassName: string;
  badgeHref: string;
  badgeIcon: IconName;
  badgeLabel: string;
  badgeIconClassName: string;
  tools: ToolCardTool[];
};

const { locale } = Astro.props;

const t = getTranslations(locale);
const prefix = locale === I18n.defaultLocale ? "" : `/${locale}`;
const hasRubyBodyFont = ["cmn", "nan", "wuu", "yue"].includes(locale);
const bodyFontClass = hasRubyBodyFont ? "font-jyutping" : "";
const toolLogoClassName =
  "size-11 shrink-0 overflow-hidden rounded-xl ring-1 ring-slate-900/6";
const linkedToolRowClassName =
  "group target-control flex items-center gap-3.5 rounded-xl px-3 py-3 -mx-3 text-slate-900 no-underline transition-colors hover:bg-[#f6f9fc] hover:text-[#0b467e] hover:no-underline visited:text-slate-900";

const specimenSyllables = [
  { char: "粵", jyutping: "jyut6" },
  { char: "語", jyutping: "jyu5" },
  { char: "拼", jyutping: "ping3" },
  { char: "音", jyutping: "jam1" },
] as const;

const localeLinks: ReadonlyArray<{
  locale: Exclude<Locale, "yue_hans">;
  label: string;
}> = [
  { locale: "yue", label: "返去粵語版" },
  { locale: "cmn", label: "切到普通話 / 國語版" },
  { locale: "nan", label: "換到台灣閩南語版" },
  { locale: "wuu", label: "換到吳語版" },
  { locale: "vi", label: "Chuyển sang tiếng Việt" },
  { locale: "en", label: "Switch to English" },
  { locale: "ja", label: "日本語版に切り替える" },
];

const whyLearnItems: Array<{ icon: IconName; text: string }> = [
  { icon: "ear", text: t.reasonEar },
  { icon: "language", text: t.reasonLanguage },
  { icon: "keyboard", text: t.reasonKeyboard },
];

const toolCards: ToolCard[] = [
  {
    accentClassName: "border-[#1678d3]",
    badgeHref: `${prefix}/keyboard#input-methods`,
    badgeIcon: "keyboard",
    badgeIconClassName: "text-[#1678d3]",
    badgeLabel: t.typeItHeading,
    tools: [
      {
        name: "TypeDuck",
        sub: "typeduck.hk",
        href: "https://www.typeduck.hk/web/",
        image: typeduckLogo,
      },
      {
        name: "粵拼輸入法",
        sub: "jyutping.app",
        href: "https://jyutping.app/",
        image: jyutpingAppLogo,
      },
      {
        name: "Cantoboard",
        sub: "App Store",
        href: "https://apps.apple.com/us/app/cantoboard-%E6%99%BA%E8%83%BD%E5%BB%A3%E6%9D%B1%E8%A9%B1%E4%B8%AD%E6%96%87%E8%BC%B8%E5%85%A5%E6%B3%95%E9%8D%B5%E7%9B%A4/id6752963850",
        image: cantoboardLogo,
      },
    ],
  },
  {
    accentClassName: "border-[#4d8f3f]",
    badgeHref: `${prefix}/keyboard#dictionaries`,
    badgeIcon: "vocabulary",
    badgeIconClassName: "text-[#4d8f3f]",
    badgeLabel: t.lookItUpHeading,
    tools: [
      {
        name: "粵音資料集叢",
        sub: "jyut.net",
        href: "https://jyut.net/",
        image: jyutnetLogo,
        backgroundClassName: "bg-[#647d8a]",
      },
      {
        name: "粵語辭叢",
        sub: "jyutjyu.com",
        href: "https://jyutjyu.com/",
        publicSrc: "/img/jyutjyu.svg",
        backgroundClassName: "bg-white",
      },
      {
        name: "Google Translate",
        sub: "translate.google.com",
        href: "https://translate.google.com/?hl=yue&sl=auto&tl=en&op=translate",
        image: googleTranslateLogo,
        backgroundClassName: "bg-white",
      },
    ],
  },
  {
    accentClassName: "border-[#d4a21c]",
    badgeHref: `${prefix}/keyboard#learning`,
    badgeIcon: "player-play-filled",
    badgeIconClassName: "text-[#b8860b]",
    badgeLabel: t.learnItHeading,
    tools: [
      {
        name: "LearnDuck",
        sub: "learnduck.app",
        href: "https://chaaklau.github.io/LearnDuck/",
        image: learnduckLogo,
      },
      {
        name: "冚唪唥粵文",
        sub: "hambaanglaang.hk",
        href: "https://hambaanglaang.hk/",
        image: hambaanglaangLogo,
      },
      {
        name: "翻轉粵語教室",
        sub: "polyu.edu.hk",
        href: "https://www.polyu.edu.hk/clc/cantonese/home/",
        image: flippedLogo,
      },
    ],
  },
];
---

<section class="brand-hero text-white">
  <div class="mx-auto max-w-7xl px-6 pb-14 pt-24 md:pb-16 md:pt-28">
    <div class="flex flex-col items-center gap-12 lg:flex-row lg:items-center lg:justify-center lg:gap-14 xl:gap-20">
      <div class="min-w-0 max-w-lg text-center lg:text-left">
        <h1 class="font-jyutping text-7xl leading-[1.3] tracking-wide md:text-8xl lg:text-9xl">
          粵拼
        </h1>
        <div class="mt-6 space-y-2">
          {
            t.subheading.map((line) => (
              <p
                class:list={[
                  hasRubyBodyFont
                    ? "font-jyutping text-3xl leading-[1.45] text-white/95 sm:text-4xl lg:text-[2.625rem]"
                    : "text-2xl leading-[1.5] font-medium text-white/95 md:text-3xl",
                ]}
              >
                {line}
              </p>
            ))
          }
        </div>
        <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap lg:justify-start">
          <a
            href={`${prefix}/learn`}
            class="target-control inline-flex items-center gap-2.5 rounded-full bg-[#f8df6c] px-7 py-3.5 text-lg font-semibold text-slate-900 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-[#fae688] active:translate-y-0"
          >
            {t.learnButton}
            <Icon name="vocabulary" size="1.25rem" />
          </a>
          <a
            href={`${prefix}/keyboard`}
            class="target-control inline-flex items-center gap-2.5 rounded-full border border-white/30 bg-[#0b467e]/30 px-7 py-3.5 text-lg font-semibold text-white transition-colors hover:border-white/60 hover:bg-[#0b467e]/45"
          >
            {t.tryKeyboardButton}
            <Icon name="keyboard" size="1.25rem" />
          </a>
        </div>
      </div>

      <div class="w-full max-w-md lg:w-[29rem] xl:w-[32rem] shrink-0">
        <JyutpingTypingDemo locale={locale} />
      </div>
    </div>
  </div>
</section>

<section class="defer-section bg-white text-slate-900">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <h2 class="mb-10 text-center text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
      {t.whyLearnHeading}
    </h2>
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-12">
      {
        whyLearnItems.map(({ icon, text }, idx) => (
          <div class="flex flex-col items-start border-t border-[#dce6f0] pt-6">
            <div class="flex w-full items-center justify-between gap-3">
              <div class="inline-flex size-10 items-center justify-center rounded-xl bg-[#eef5fc] text-[#1678d3]">
                <Icon name={icon} size="1.5rem" stroke={1.65} />
              </div>
              <span class="text-xs font-semibold tabular-nums tracking-widest text-[#0e5394]">
                {String(idx + 1).padStart(2, "0")}
              </span>
            </div>
            <p class="mt-4 text-lg leading-relaxed text-slate-700">{text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="bg-[#f6f9fc] text-slate-900">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2
          class="mb-4 inline-flex items-center gap-2 rounded-full bg-[#eef5fc] px-3.5 py-1 text-sm font-semibold text-[#0b467e]"
        >
          <Icon name="sparkles" size="1rem" />
          {t.whatIsHeading}
        </h2>
        <div
          class:list={[
            hasRubyBodyFont
              ? "font-jyutping space-y-4 text-3xl leading-[1.45] text-slate-900 sm:text-4xl lg:text-5xl"
              : "space-y-4 text-2xl leading-[1.55] font-medium text-slate-900 md:text-3xl",
          ]}
        >
          {t.whatIsBody.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a
          href={`${prefix}/jyutping`}
          class="target-control group mt-6 inline-flex items-center gap-2 text-base font-semibold text-[#0e5394] no-underline transition-colors hover:text-[#0b467e]"
        >
          <span>{t.viewSchemeButton}</span>
          <Icon name="arrow-right" size="1.125rem" class="transition-transform group-hover:translate-x-0.5" />
        </a>
      </div>
      <div class="surface-card ring-1 ring-[#dce6f0]/80 p-8 md:p-10">
        <div>
          <p
            lang="yue"
            class="font-jyutping text-4xl leading-[1.45] font-medium text-[#0b467e] sm:text-5xl"
          >
            粵語拼音
          </p>
        </div>

        <div class="mt-6 grid grid-cols-4 gap-2 sm:gap-3">
          {
            specimenSyllables.map((syllable) => (
              <div class="flex flex-col items-center rounded-2xl bg-[#eef5fc] px-2 py-3 text-center">
                <div class="flex items-center gap-0.5">
                  <span lang="yue" class="text-2xl font-semibold text-slate-900">
                    {syllable.char}
                  </span>
                  <Audio id={syllable.jyutping} locale={locale} />
                </div>
                <span lang="yue-Latn-jyutping" class="mt-1 font-mono text-sm font-semibold text-[#0b467e]">
                  {syllable.jyutping}
                </span>
              </div>
            ))
          }
        </div>

        <div class="mt-6 flex items-center justify-between gap-3 border-t border-[#dce6f0] pt-5">
          <p
            class="inline-flex items-center gap-3 text-xl font-medium text-[#0e5394] md:text-2xl"
          >
            <span lang="yue-Latn-jyutping">ping3 jam1</span>
            <Icon name="arrow-right" size="1.25rem" />
            <span lang="yue">拼音</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="defer-section bg-white text-slate-900">
  <div class="mx-auto max-w-7xl px-6 py-12 md:py-16">
    <h2 class="mb-10 text-center text-3xl font-bold tracking-tight md:text-4xl">
      {t.everythingHeading}
    </h2>
    <div class="grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-8">
      {
        toolCards.map((card) => (
          <div class:list={["flex flex-col border-t-2 pt-5", card.accentClassName]}>
            <a
              href={card.badgeHref}
              class="target-control group mb-5 inline-flex w-fit items-center gap-2 text-xl font-bold tracking-tight text-slate-900 no-underline transition-colors hover:text-[#0b467e]"
            >
              <Icon name={card.badgeIcon} size="1.25rem" class={card.badgeIconClassName} />
              <span>{card.badgeLabel}</span>
              <Icon
                name="arrow-right"
                size="1rem"
                class="text-slate-400 transition-all group-hover:translate-x-0.5 group-hover:text-[#0b467e]"
              />
            </a>
            <div class="space-y-1">
              {card.tools.map((tool) => (
                <a
                  href={tool.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class={linkedToolRowClassName}
                >
                  <div
                    class={`${toolLogoClassName} ${
                      tool.backgroundClassName ?? "bg-white"
                    }`}
                  >
                    {tool.image ? (
                      tool.image.format === "svg" ? (
                        <Image
                          src={tool.image}
                          alt={tool.name}
                          format="svg"
                          width={44}
                          height={44}
                          class="h-full w-full object-cover"
                          loading="lazy"
                        />
                      ) : (
                        <Picture
                          src={tool.image}
                          alt={tool.name}
                          formats={["avif", "webp"]}
                          widths={[48, 96]}
                          sizes="2.75rem"
                          class="h-full w-full object-cover"
                          loading="lazy"
                        />
                      )
                    ) : (
                      <img
                        src={tool.publicSrc}
                        alt={tool.name}
                        width={44}
                        height={44}
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                    )}
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-base font-semibold text-slate-900 group-hover:text-[#0b467e]">
                      {tool.name}
                    </p>
                    <p class="truncate text-sm text-slate-500">
                      {tool.sub}
                    </p>
                  </div>
                  <Icon
                    name="arrow-up-right"
                    size="1rem"
                    class="shrink-0 text-slate-400 transition-colors group-hover:text-[#1678d3]"
                  />
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="defer-section brand-hero text-white">
  <div class="mx-auto max-w-5xl px-6 py-12 md:py-16 text-center">
    <p class:list={[bodyFontClass, "mb-8 text-3xl leading-[1.4] font-medium md:text-5xl"]}>
      {t.tagline}
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href={`${prefix}/jyutping`}
        class="target-control inline-flex items-center gap-2 rounded-full bg-[#f8df6c] px-7 py-3.5 text-lg font-semibold text-slate-900 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-[#fae688]"
      >
        {t.viewSchemeButton}
        <Icon name="table" size="1.25rem" />
      </a>
      <a
        href={`${prefix}/keyboard`}
        class="target-control inline-flex items-center gap-2 rounded-full border border-white/30 bg-[#0b467e]/30 px-7 py-3.5 text-lg font-semibold text-white transition-colors hover:border-white/60 hover:bg-[#0b467e]/45"
      >
        {t.resourcesButton}
        <Icon name="keyboard" size="1.25rem" />
      </a>
    </div>
  </div>
</section>

<section class="defer-section border-t border-[#dce6f0] bg-[#f6f9fc] text-slate-900">
  <div class="mx-auto max-w-6xl px-6 py-8">
    <h2
      class="mb-6 flex items-center justify-center gap-2 text-center text-lg font-semibold text-slate-700"
    >
      <Icon name="world" size="1.25rem" class="text-[#1678d3]" />
      {t.otherLanguagesHeading}
    </h2>
    <div class="flex flex-wrap-balance justify-center gap-2.5">
      {
        localeLinks
          .filter((link) => link.locale !== locale.replace(/_.*/, ""))
          .map((link) => (
            <a
              lang={formatBcp47Locale(link.locale)}
              href={
                link.locale === I18n.defaultLocale ? "/" : `/${link.locale}`
              }
              class="target-control inline-flex items-center rounded-full bg-white px-5 py-2 text-sm sm:text-base font-medium text-slate-800 shadow-[0_1px_2px_rgb(15_41_66/0.06)] ring-1 ring-[#dce6f0] transition-all hover:bg-[#eef5fc] hover:text-[#0b467e] hover:ring-[#1678d3]"
            >
              {link.label}
            </a>
          ))
      }
    </div>
  </div>
</section>
