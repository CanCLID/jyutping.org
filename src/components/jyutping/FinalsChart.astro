---
import PhoneticToken from "@/components/jyutping/PhoneticToken.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { getJyutpingTableLabels } from "@/data/jyutping";
import { getUiLabels } from "@/i18n/uiLabels";
import {
  finalsChartHighlightCellClass,
  finalsChartMutedCellClass,
  finalsChartTableClass,
  finalsChartTableDataCellClass,
  finalsChartTableHeadCellClass,
} from "@/components/jyutping/tableStyles";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const labels = getJyutpingTableLabels(locale);
const ui = getUiLabels(locale);
---

<ScrollableTable
