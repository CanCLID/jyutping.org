      <th class={finalsChartTableHeadCellClass} colspan={2} scope="colgroup">{labels.finalsChartColHeaders1[1]}</th>
      <th class={finalsChartTableHeadCellClass} colspan={3} scope="colgroup">{labels.finalsChartColHeaders1[2]}</th>
      <th class={finalsChartTableHeadCellClass} colspan={3} scope="colgroup">{labels.finalsChartColHeaders1[3]}</th>
    </tr>
    <tr>
      {labels.finalsChartColHeaders2.map((header) => (
        <th class={finalsChartTableHeadCellClass} scope="col">{header}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    <tr>
      <th class:list={[finalsChartTableHeadCellClass, "sticky-row-header"]} rowspan={2} scope="row">i</th>
