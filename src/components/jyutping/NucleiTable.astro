---
import PhoneticToken from "@/components/jyutping/PhoneticToken.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { I18n } from "@/i18n/utils";
import { getUiLabels } from "@/i18n/uiLabels";
import { tableClass, tableDataCellClass } from "@/components/jyutping/tableStyles";

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale || I18n.defaultLocale } = Astro.props;
const ui = getUiLabels(locale);
---

<ScrollableTable
  caption={ui.nucleiTableCaption}
  captionId="nuclei-table-caption"
  tableClass={tableClass}
>
  <tbody>
    <tr>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="i" ipa="[iː]" example="詩" audioId="si1" locale={locale} />
        <br />
        <PhoneticToken
          jyutping="i"
          sub="後接 -ng, -k"
          ipa="[e]"
          example="星"
          audioId="sing1"
          extraExample={{ char: "識", audioId: "sik1" }}
          locale={locale}
        />
        <br />
        <PhoneticToken jyutping="yu" ipa="[y]" example="書" audioId="syu1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue"></td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="u" ipa="[uː]" example="夫" audioId="fu1" locale={locale} />
        <br />
        <PhoneticToken
          jyutping="u"
          sub="後接 -ng, -k"
          ipa="[o]"
          example="風"
          audioId="fung1"
          extraExample={{ char: "福", audioId: "fuk1" }}
          locale={locale}
        />
      </td>
    </tr>
    <tr>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="e" sub="後接 -i" ipa="[e]" example="四" audioId="sei3" locale={locale} />
        <br />
        <PhoneticToken jyutping="eo" ipa="[ɵ]" example="詢" audioId="seon1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue"></td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="o" sub="後接 -u" ipa="[o]" example="蘇" audioId="sou1" locale={locale} />
      </td>
    </tr>
    <tr>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="e" ipa="[ɛː]" example="些" audioId="se1" locale={locale} />
        <br />
        <PhoneticToken jyutping="oe" ipa="[œː]" example="鋸" audioId="goe3" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="a" ipa="[ɐ]" example="新" audioId="san1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="o" ipa="[ɔː]" example="疏" audioId="so1" locale={locale} />
      </td>
    </tr>
    <tr>
      <td class={tableDataCellClass} lang="yue"></td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="aa" ipa="[aː]" example="沙" audioId="saa1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue"></td>
    </tr>
  </tbody>
</ScrollableTable>
