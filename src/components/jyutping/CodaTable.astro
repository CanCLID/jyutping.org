---
import Audio from "@/components/Audio.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { getJyutpingTableLabels } from "@/data/jyutping";
import { getUiLabels } from "@/i18n/uiLabels";
import { tableClass, tableDataCellClass, tableHeadCellClass } from "@/components/jyutping/tableStyles";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const labels = getJyutpingTableLabels(locale);
const ui = getUiLabels(locale);
---

<ScrollableTable
  caption={ui.codaTableCaption}
  captionId="coda-table-caption"
  tableClass={tableClass}
  sticky
>
  <tbody>
    <tr>
      <th class:list={[tableHeadCellClass, "sticky-row-header"]} scope="row">{labels.codaRowHeaders[0]}</th>
      <td class={tableDataCellClass} lang="yue">
        p [p̚] 溼 <Audio id="sap1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        t [t̚] 失 <Audio id="sat1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        k [k̚] 塞 <Audio id="sak1" locale={locale} />
      </td>
    </tr>
    <tr>
      <th class:list={[tableHeadCellClass, "sticky-row-header"]} scope="row">{labels.codaRowHeaders[1]}</th>
      <td class={tableDataCellClass} lang="yue">
        m [m] 心 <Audio id="sam1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        n [n] 身 <Audio id="san1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        ng [ŋ] 生 <Audio id="sang1" locale={locale} />
      </td>
    </tr>
    <tr>
      <th class:list={[tableHeadCellClass, "sticky-row-header"]} scope="row">{labels.codaRowHeaders[2]}</th>
      <td class={tableDataCellClass} lang="yue"></td>
      <td class={tableDataCellClass} lang="yue">
        i [i] 西 <Audio id="sai1" locale={locale} /> 需 <Audio id="seoi1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        u [u] 收 <Audio id="sau1" locale={locale} />
      </td>
    </tr>
  </tbody>
</ScrollableTable>
