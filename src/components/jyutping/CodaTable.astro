---
import PhoneticToken from "@/components/jyutping/PhoneticToken.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { getJyutpingTableLabels } from "@/data/jyutping";
import { getUiLabels } from "@/i18n/uiLabels";
import { tableClass, tableDataCellClass, tableHeadCellClass } from "@/components/jyutping/tableStyles";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const labels = getJyutpingTableLabels(locale);
const ui = getUiLabels(locale);
---

<ScrollableTable
  caption={ui.codaTableCaption}
  captionId="coda-table-caption"
  tableClass={tableClass}
  sticky
>
  <tbody>
    <tr>
      <th class:list={[tableHeadCellClass, "sticky-row-header"]} scope="row">{labels.codaRowHeaders[0]}</th>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="p" ipa="[p̚]" example="溼" audioId="sap1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="t" ipa="[t̚]" example="失" audioId="sat1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="k" ipa="[k̚]" example="塞" audioId="sak1" locale={locale} />
      </td>
    </tr>
    <tr>
      <th class:list={[tableHeadCellClass, "sticky-row-header"]} scope="row">{labels.codaRowHeaders[1]}</th>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="m" ipa="[m]" example="心" audioId="sam1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="n" ipa="[n]" example="身" audioId="san1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="ng" ipa="[ŋ]" example="生" audioId="sang1" locale={locale} />
      </td>
    </tr>
    <tr>
      <th class:list={[tableHeadCellClass, "sticky-row-header"]} scope="row">{labels.codaRowHeaders[2]}</th>
      <td class={tableDataCellClass} lang="yue"></td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken
          jyutping="i"
          ipa="[i]"
          example="西"
          audioId="sai1"
          extraExample={{ char: "需", audioId: "seoi1" }}
          locale={locale}
        />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="u" ipa="[u]" example="收" audioId="sau1" locale={locale} />
      </td>
    </tr>
  </tbody>
</ScrollableTable>
