---
import PhoneticToken from "@/components/jyutping/PhoneticToken.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { I18n } from "@/i18n/utils";
import { getUiLabels } from "@/i18n/uiLabels";
import { tableClass, tableDataCellClass } from "@/components/jyutping/tableStyles";

interface Props {
  locale?: string;
}

const { locale = Astro.currentLocale || I18n.defaultLocale } = Astro.props;
const ui = getUiLabels(locale);
---

<ScrollableTable
  caption={ui.syllabicNasalTableCaption}
  captionId="syllabic-nasal-table-caption"
  tableClass={tableClass}
>
  <tbody>
    <tr>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="m" ipa="[m̩]" example="唔" audioId="m4" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="ng" ipa="[ŋ̩]" example="吳" audioId="ng4" locale={locale} />
      </td>
    </tr>
  </tbody>
</ScrollableTable>
