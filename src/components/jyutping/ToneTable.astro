---
import PhoneticToken from "@/components/jyutping/PhoneticToken.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { getJyutpingTableLabels } from "@/data/jyutping";
import { getUiLabels } from "@/i18n/uiLabels";
import { tableClass, tableDataCellClass, toneTableHeadCellClass } from "@/components/jyutping/tableStyles";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const labels = getJyutpingTableLabels(locale);
const ui = getUiLabels(locale);
---

<ScrollableTable
  caption={ui.toneTableCaption}
  captionId="tone-table-caption"
  tableClass={tableClass}
  sticky
>
  <thead>
    <tr>
      <th class={toneTableHeadCellClass} scope="col">
        <span class="visually-hidden">{ui.toneTableCaption}</span>
      </th>
      {labels.toneTableHeaders.map((header) => (
        <th class={toneTableHeadCellClass} scope="col">{header}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    <tr>
      <th class:list={[toneTableHeadCellClass, "sticky-row-header"]} scope="row">{labels.toneRowHeaders[0]}</th>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="1" ipa="[˥]" example="詩" audioId="si1" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="2" ipa="[˧˥]" example="史" audioId="si2" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="3" ipa="[˧]" example="試" audioId="si3" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="1" ipa="[˥]" example="識" audioId="sik1" locale={locale} />
        <br />
        <PhoneticToken jyutping="3" ipa="[˧]" example="洩" audioId="sit3" locale={locale} />
      </td>
    </tr>
    <tr>
      <th class:list={[toneTableHeadCellClass, "sticky-row-header"]} scope="row">{labels.toneRowHeaders[1]}</th>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="4" ipa="[˨˩]" example="時" audioId="si4" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="5" ipa="[˩˧]" example="市" audioId="si5" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="6" ipa="[˨]" example="事" audioId="si6" locale={locale} />
      </td>
      <td class={tableDataCellClass} lang="yue">
        <PhoneticToken jyutping="6" ipa="[˨]" example="蝕" audioId="sit6" locale={locale} />
      </td>
    </tr>
  </tbody>
</ScrollableTable>
