---
import Audio from "@/components/Audio.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { getJyutpingTableLabels } from "@/data/jyutping";
import { getUiLabels } from "@/i18n/uiLabels";
import { tableClass, tableDataCellClass, toneTableHeadCellClass } from "@/components/jyutping/tableStyles";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const labels = getJyutpingTableLabels(locale);
const ui = getUiLabels(locale);
---

<ScrollableTable
  caption={ui.toneTableCaption}
  captionId="tone-table-caption"
  tableClass={tableClass}
  sticky
>
  <thead>
    <tr>
      <th class={toneTableHeadCellClass} scope="col">
        <span class="visually-hidden">{ui.toneTableCaption}</span>
      </th>
      {labels.toneTableHeaders.map((header) => (
        <th class={toneTableHeadCellClass} scope="col">{header}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    <tr>
      <th class:list={[toneTableHeadCellClass, "sticky-row-header"]} scope="row">{labels.toneRowHeaders[0]}</th>
      <td class={tableDataCellClass} lang="yue">1 [˥] 詩 <Audio id="si1" locale={locale} /></td>
      <td class={tableDataCellClass} lang="yue">2 [˧˥] 史 <Audio id="si2" locale={locale} /></td>
      <td class={tableDataCellClass} lang="yue">3 [˧] 試 <Audio id="si3" locale={locale} /></td>
      <td class={tableDataCellClass} lang="yue">
        1 [˥] 識 <Audio id="sik1" locale={locale} />
        <br />3 [˧] 洩 <Audio id="sit3" locale={locale} />
      </td>
    </tr>
    <tr>
      <th class:list={[toneTableHeadCellClass, "sticky-row-header"]} scope="row">{labels.toneRowHeaders[1]}</th>
      <td class={tableDataCellClass} lang="yue">4 [˨˩] 時 <Audio id="si4" locale={locale} /></td>
      <td class={tableDataCellClass} lang="yue">5 [˩˧] 市 <Audio id="si5" locale={locale} /></td>
      <td class={tableDataCellClass} lang="yue">6 [˨] 事 <Audio id="si6" locale={locale} /></td>
      <td class={tableDataCellClass} lang="yue">6 [˨] 蝕 <Audio id="sit6" locale={locale} /></td>
    </tr>
  </tbody>
</ScrollableTable>
