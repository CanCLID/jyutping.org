---
import Audio from "@/components/Audio.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { getJyutpingTableLabels } from "@/data/jyutping";
import { getUiLabels } from "@/i18n/uiLabels";
import {
  tableClass,
  tableDataCellClass,
  tableHeadCellClass,
} from "@/components/jyutping/tableStyles";

interface Props {
  locale: string;
}

type CellEntry = { label: string; audioId: string };
type OnsetRowKey =
  | "plosive"
  | "affricate"
  | "nasal"
  | "fricative"
  | "approximant"
  | "lateral";

const { locale } = Astro.props;
const labels = getJyutpingTableLabels(locale);
const ui = getUiLabels(locale);

const onsetCellsByRow: Record<OnsetRowKey, CellEntry[][]> = {
  plosive: [
    [
      { label: "b [p] 巴", audioId: "baa1" },
      { label: "p [pʰ] 怕", audioId: "paa3" },
    ],
    [],
    [
      { label: "d [t] 打", audioId: "daa2" },
      { label: "t [tʰ] 他", audioId: "taa1" },
    ],
    [],
    [
      { label: "g [k] 家", audioId: "gaa1" },
      { label: "k [kʰ] 卡", audioId: "kaa1" },
      { label: "gw [kʷ] 瓜", audioId: "gwaa1" },
      { label: "kw [kʷʰ] 夸", audioId: "kwaa1" },
    ],
    [],
  ],
  affricate: [
    [],
    [],
    [
      { label: "z [t͡s~t͡ʃ] 渣", audioId: "zaa1" },
      { label: "c [t͡sʰ~t͡ʃʰ] 叉", audioId: "caa1" },
    ],
    [],
    [],
    [],
  ],
  nasal: [
    [{ label: "m [m] 媽", audioId: "maa1" }],
    [],
    [{ label: "n [n] 那", audioId: "naa5" }],
    [],
    [{ label: "ng [ŋ] 牙", audioId: "ngaa4" }],
    [],
  ],
  fricative: [
    [],
    [{ label: "f [f] 花", audioId: "faa1" }],
    [{ label: "s [s] 沙", audioId: "saa1" }],
    [],
    [],
    [{ label: "h [h] 蝦", audioId: "haa1" }],
  ],
  approximant: [
    [{ label: "w [w] 蛙", audioId: "waa1" }],
    [],
    [],
    [{ label: "j [j] 也", audioId: "jaa5" }],
    [],
    [],
  ],
  lateral: [
    [],
    [],
    [{ label: "l [l] 啦", audioId: "laa1" }],
    [],
    [],
    [],
  ],
};
---

<ScrollableTable
  caption={ui.onsetTableCaption}
  captionId="onset-table-caption"
  tableClass={tableClass}
  sticky
>
  <thead>
    <tr>
      <th class={tableHeadCellClass} scope="col">
        <span class="visually-hidden">{ui.onsetTableCaption}</span>
      </th>
      {labels.onsetTableHeaders.map((header) => (
        <th class={tableHeadCellClass} scope="col">{header}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    {labels.onsetRowOrder.map((rowKey) => (
      <tr>
        <th class:list={[tableHeadCellClass, "sticky-row-header"]} scope="row">
          {labels.onsetTableRowLabels[rowKey]}
        </th>
        {onsetCellsByRow[rowKey].map((entries) => (
          <td class={tableDataCellClass} lang="yue">
            {entries.map((entry, idx) => (
              <>
                {idx > 0 && <br />}
                <span class="whitespace-nowrap">
                  {entry.label} <Audio id={entry.audioId} locale={locale} />
                </span>
              </>
            ))}
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</ScrollableTable>
