---
import PhoneticToken from "@/components/jyutping/PhoneticToken.astro";
import ScrollableTable from "@/components/ScrollableTable.astro";
import { getJyutpingTableLabels } from "@/data/jyutping";
import { getUiLabels } from "@/i18n/uiLabels";
import {
  tableClass,
  tableDataCellClass,
  tableHeadCellClass,
} from "@/components/jyutping/tableStyles";

interface Props {
  locale: string;
}

type CellEntry = {
  jyutping: string;
  ipa: string;
  example: string;
  audioId: string;
};

type OnsetRowKey =
  | "plosive"
  | "affricate"
  | "nasal"
  | "fricative"
  | "approximant"
  | "lateral";

const { locale } = Astro.props;
const labels = getJyutpingTableLabels(locale);
const ui = getUiLabels(locale);

const onsetCellsByRow: Record<OnsetRowKey, CellEntry[][]> = {
  plosive: [
    [
      { jyutping: "b", ipa: "[p]", example: "巴", audioId: "baa1" },
      { jyutping: "p", ipa: "[pʰ]", example: "怕", audioId: "paa3" },
    ],
    [],
    [
      { jyutping: "d", ipa: "[t]", example: "打", audioId: "daa2" },
      { jyutping: "t", ipa: "[tʰ]", example: "他", audioId: "taa1" },
    ],
    [],
    [
      { jyutping: "g", ipa: "[k]", example: "家", audioId: "gaa1" },
      { jyutping: "k", ipa: "[kʰ]", example: "卡", audioId: "kaa1" },
      { jyutping: "gw", ipa: "[kʷ]", example: "瓜", audioId: "gwaa1" },
      { jyutping: "kw", ipa: "[kʷʰ]", example: "夸", audioId: "kwaa1" },
    ],
    [],
  ],
  affricate: [
    [],
    [],
    [
      { jyutping: "z", ipa: "[t͡s~t͡ʃ]", example: "渣", audioId: "zaa1" },
      { jyutping: "c", ipa: "[t͡sʰ~t͡ʃʰ]", example: "叉", audioId: "caa1" },
    ],
    [],
    [],
    [],
  ],
  nasal: [
    [{ jyutping: "m", ipa: "[m]", example: "媽", audioId: "maa1" }],
    [],
    [{ jyutping: "n", ipa: "[n]", example: "那", audioId: "naa5" }],
    [],
    [{ jyutping: "ng", ipa: "[ŋ]", example: "牙", audioId: "ngaa4" }],
    [],
  ],
  fricative: [
    [],
    [{ jyutping: "f", ipa: "[f]", example: "花", audioId: "faa1" }],
    [{ jyutping: "s", ipa: "[s]", example: "沙", audioId: "saa1" }],
    [],
    [],
    [{ jyutping: "h", ipa: "[h]", example: "蝦", audioId: "haa1" }],
  ],
  approximant: [
    [{ jyutping: "w", ipa: "[w]", example: "蛙", audioId: "waa1" }],
    [],
    [],
    [{ jyutping: "j", ipa: "[j]", example: "也", audioId: "jaa5" }],
    [],
    [],
  ],
  lateral: [
    [],
    [],
    [{ jyutping: "l", ipa: "[l]", example: "啦", audioId: "laa1" }],
    [],
    [],
    [],
  ],
};
---

<ScrollableTable
  caption={ui.onsetTableCaption}
  captionId="onset-table-caption"
  tableClass={tableClass}
  sticky
>
  <thead>
    <tr>
      <th class={tableHeadCellClass} scope="col">
        <span class="visually-hidden">{ui.onsetTableCaption}</span>
      </th>
      {labels.onsetTableHeaders.map((header) => (
        <th class={tableHeadCellClass} scope="col">{header}</th>
      ))}
    </tr>
  </thead>
  <tbody>
    {labels.onsetRowOrder.map((rowKey) => (
      <tr>
        <th class:list={[tableHeadCellClass, "sticky-row-header"]} scope="row">
          {labels.onsetTableRowLabels[rowKey]}
        </th>
        {onsetCellsByRow[rowKey].map((entries) => (
          <td class={tableDataCellClass} lang="yue">
            {entries.map((entry, idx) => (
              <>
                {idx > 0 && <br />}
                <PhoneticToken
                  jyutping={entry.jyutping}
                  ipa={entry.ipa}
                  example={entry.example}
                  audioId={entry.audioId}
                  locale={locale}
                />
              </>
            ))}
          </td>
        ))}
      </tr>
    ))}
  </tbody>
</ScrollableTable>
