---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNonDefaultLocaleStaticPaths } from "@/i18n/utils";
import { getTitle, makeTitle } from "@/i18n/pageHeadings";
import { getPageMeta } from "@/i18n/pageMeta";
import { isSupportedLocale, toCanonicalUrl } from "@/utils/content";
import { buildHomeJsonLd, getCanonicalSiteUrl } from "@/utils/jsonLd";

import IndexPage from "@/components/IndexPage.astro";

export function getStaticPaths() {
  return getNonDefaultLocaleStaticPaths();
}

const { locale } = Astro.params;

if (!locale || !isSupportedLocale(locale)) {
  throw new Error(`Invalid locale parameter for index page: ${locale ?? "undefined"}.`);
}

const title = getTitle("index", locale);
const description = getPageMeta(locale).descriptions.index;
const siteUrl = getCanonicalSiteUrl(Astro.site);
const jsonLd = buildHomeJsonLd({
  siteUrl,
  locale,
  title: makeTitle(title, locale, true),
  description,
  canonicalUrl: toCanonicalUrl(Astro.url.pathname, siteUrl),
});
---

<BaseLayout lang={locale} title={title} description={description} jsonLd={jsonLd} flipTitle>
  <IndexPage locale={locale} />
</BaseLayout>
