---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import TableOfContents from "@/components/TableOfContents.astro";
import ContentWithTocShell from "@/components/content/ContentWithTocShell.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { makeTitle } from "@/i18n/pageHeadings";
import { getPageMeta } from "@/i18n/pageMeta";
import {
  getEntryLocale,
  getNonDefaultLocaleCollectionEntryStaticPaths,
  isSupportedLocale,
  toCanonicalUrl,
} from "@/utils/content";
import { buildLearnJsonLd, getCanonicalSiteUrl } from "@/utils/jsonLd";
import { sharedMdxComponents } from "@/utils/mdx";

export async function getStaticPaths() {
  return getNonDefaultLocaleCollectionEntryStaticPaths("learn");
}

interface Props {
  entry: CollectionEntry<"learn">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { locale } = Astro.params;

if (!locale || !isSupportedLocale(locale)) {
  throw new Error(`Invalid locale parameter for learn page: ${locale ?? "undefined"}.`);
}

const lang = getEntryLocale(entry.id) || locale;
const description = entry.data.description ?? getPageMeta(lang).descriptions.index;
const siteUrl = getCanonicalSiteUrl(Astro.site);
const jsonLd = buildLearnJsonLd({
  siteUrl,
  locale: lang,
  title: makeTitle(entry.data.title, lang),
  description,
  canonicalUrl: toCanonicalUrl(Astro.url.pathname, siteUrl),
});
---

<BaseLayout
  title={entry.data.title}
  description={description}
  lang={lang}
  ogType="article"
  jsonLd={jsonLd}
>
  <ContentWithTocShell
    title={entry.data.title}
    description={entry.data.description}
  >
    <Content components={sharedMdxComponents} />
    <TableOfContents slot="toc" headings={headings} locale={lang} />
  </ContentWithTocShell>
</BaseLayout>
