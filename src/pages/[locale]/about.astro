---
import { render } from "astro:content";
import AboutGrid from "@/components/about/AboutGrid.astro";
import AboutLinkItem from "@/components/about/AboutLinkItem.astro";
import PageBanner from "@/components/PageBanner.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNonDefaultLocaleStaticPaths } from "@/i18n/utils";
import { makeTitle } from "@/i18n/pageHeadings";
import { getPageMeta } from "@/i18n/pageMeta";
import { getLocalizedSingletonEntry, isSupportedLocale, toCanonicalUrl } from "@/utils/content";
import { buildAboutJsonLd, getCanonicalSiteUrl } from "@/utils/jsonLd";
import { sharedMdxComponents } from "@/utils/mdx";

export function getStaticPaths() {
  return getNonDefaultLocaleStaticPaths();
}

const { locale } = Astro.params;

if (!locale || !isSupportedLocale(locale)) {
  throw new Error(`Invalid locale parameter for about page: ${locale ?? "undefined"}.`);
}

const entry = await getLocalizedSingletonEntry("about", locale);
const { Content } = await render(entry);
const description = entry.data.description ?? getPageMeta(locale).descriptions.about;
const siteUrl = getCanonicalSiteUrl(Astro.site);
const jsonLd = buildAboutJsonLd({
  siteUrl,
  locale,
  title: makeTitle(entry.data.title, locale),
  description,
  canonicalUrl: toCanonicalUrl(Astro.url.pathname, siteUrl),
});
---

<BaseLayout
  lang={locale}
  title={entry.data.title}
  description={description}
  jsonLd={jsonLd}
  hasHero
>
  <PageBanner
    eyebrow={entry.data.title}
    title="jyutping.org"
    subtitle={description}
    align="center"
    maxWidth="6xl"
  />

  <div class="about-content mx-auto max-w-6xl px-6 py-10 md:py-12 text-slate-700">
    <Content components={{ ...sharedMdxComponents, AboutGrid, AboutLinkItem }} />
  </div>
</BaseLayout>
