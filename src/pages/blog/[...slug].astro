---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BlogCatalogue from "@/components/BlogCatalogue.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import CatalogueContentShell from "@/components/content/CatalogueContentShell.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { I18n } from "@/i18n/utils";
import { getTitle, makeTitle } from "@/i18n/pageHeadings";
import { getPageMeta } from "@/i18n/pageMeta";
import {
  getAvailableLocalesForCollectionSlug,
  getDefaultLocaleCollectionEntryStaticPaths,
  getEntryLocale,
  getEntrySlug,
  getLocalizedCollectionEntries,
  toCanonicalUrl,
} from "@/utils/content";
import { buildBlogPostJsonLd, getCanonicalSiteUrl } from "@/utils/jsonLd";
import { sharedMdxComponents } from "@/utils/mdx";

export async function getStaticPaths() {
  return getDefaultLocaleCollectionEntryStaticPaths("blog");
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const slug = getEntrySlug(entry.id);
const allBlogEntries = (
  await getLocalizedCollectionEntries("blog", I18n.defaultLocale)
).toSorted((a, b) => (a.data.weight || 0) - (b.data.weight || 0));

const lang = getEntryLocale(entry.id) || I18n.defaultLocale;
const availableLocales = await getAvailableLocalesForCollectionSlug("blog", slug);
const description = entry.data.description ?? getPageMeta(lang).descriptions.blog;
const siteUrl = getCanonicalSiteUrl(Astro.site);
const jsonLd = buildBlogPostJsonLd({
  siteUrl,
  locale: lang,
  title: makeTitle(entry.data.title, lang),
  description,
  canonicalUrl: toCanonicalUrl(Astro.url.pathname, siteUrl),
});
---

<BaseLayout
  title={entry.data.title}
  description={description}
  lang={lang}
  availableLocales={availableLocales}
  unavailableLocaleFallbackPath="/blog"
  ogType="article"
  jsonLd={jsonLd}
  hasHero
>
  <CatalogueContentShell
    eyebrow={getTitle("blog", lang)}
    title={entry.data.title}
    description={entry.data.description}
  >
    <BlogCatalogue
      slot="catalogue"
      posts={allBlogEntries}
      currentSlug={getEntrySlug(entry.id)}
    />
    <Content components={sharedMdxComponents} />
    <TableOfContents slot="toc" headings={headings} locale={lang} />
  </CatalogueContentShell>
</BaseLayout>
