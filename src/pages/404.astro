---
import Icon from "@/components/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNotFoundLabels } from "@/i18n/notFound";
import { getNavTranslation } from "@/i18n/pageHeadings";
import { I18n } from "@/i18n/utils";

const locale = I18n.defaultLocale;
const copy = getNotFoundLabels(locale);
const enCopy = getNotFoundLabels("en");

const recoveryLinks = [
  { href: "/learn", label: getNavTranslation("learn", locale), enHref: "/en/learn", enLabel: getNavTranslation("learn", "en"), icon: "books" as const },
  { href: "/jyutping", label: getNavTranslation("jyutping", locale), enHref: "/en/jyutping", enLabel: getNavTranslation("jyutping", "en"), icon: "book-2" as const },
  { href: "/keyboard", label: getNavTranslation("keyboard", locale), enHref: "/en/keyboard", enLabel: getNavTranslation("keyboard", "en"), icon: "keyboard" as const },
  { href: "/blog", label: getNavTranslation("blog", locale), enHref: "/en/blog", enLabel: getNavTranslation("blog", "en"), icon: "arrow-right" as const },
];
---

<BaseLayout
  lang={locale}
  title={`${copy.title} (404)`}
  description={copy.message}
  availableLocales={[]}
  unavailableLocaleFallbackPath="/"
  noindex
>
  <section class="container mx-auto max-w-3xl px-6 py-16 md:py-24 text-center">
    <p class="inline-block rounded-full bg-blue-50 px-4 py-1 text-sm font-semibold text-[#1678d3] border border-blue-200">
      HTTP 404
    </p>
    <h1 class="mt-6 text-4xl md:text-5xl font-semibold text-gray-900">
      {copy.heading}
    </h1>
    <p class="mt-4 text-lg text-gray-700">
      {copy.message}
    </p>
    <p lang="en" class="mt-2 text-base text-gray-600">
      {enCopy.message}
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/"
        class="target-control inline-flex items-center gap-2 rounded-lg bg-[#1678d3] px-6 py-3 font-medium text-white shadow-sm hover:bg-[#1262ad] transition-colors"
      >
        {copy.backHome}
        <span lang="en" class="text-white/90">/ {enCopy.backHome}</span>
      </a>
    </div>

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 gap-4 text-left">
      {recoveryLinks.map((item) => (
        <div class="rounded-lg border border-gray-200 bg-white p-4 flex items-center justify-between gap-4 hover:border-blue-300 transition-colors">
          <a
            href={item.href}
            class="target-control inline-flex items-center gap-2.5 font-medium text-gray-900 hover:text-[#1678d3] transition-colors"
          >
            <Icon name={item.icon} size="1.25rem" class="text-[#1678d3] shrink-0" />
            <span>{item.label}</span>
          </a>
          <a
            href={item.enHref}
            lang="en"
            class="target-control text-sm font-medium text-[#0c569c] hover:underline shrink-0"
          >
            {item.enLabel}
          </a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
